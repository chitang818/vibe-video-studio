{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48
    },
    "authorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "[A-Za-z][A-Za-z0-9-]{0,63}"
          },
          "kind": {
            "type": "string",
            "enum": [
              "process",
              "classification",
              "exchange",
              "cross-section",
              "comparison",
              "data",
              "ending"
            ]
          },
          "heading": {
            "type": "string",
            "minLength": 2,
            "maxLength": 14
          },
          "anchor": {
            "type": "object",
            "properties": {
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              },
              "occurrence": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "quote"
            ],
            "additionalProperties": false
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16
                },
                "anchor": {
                  "type": "object",
                  "properties": {
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000
                    },
                    "occurrence": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "quote"
                  ],
                  "additionalProperties": false
                },
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8
                }
              },
              "required": [
                "text",
                "anchor"
              ],
              "additionalProperties": false
            },
            "minItems": 2,
            "maxItems": 4
          }
        },
        "required": [
          "id",
          "kind",
          "heading",
          "stages"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "titleMode": {
      "type": "string",
      "enum": [
        "shown",
        "hidden"
      ]
    },
    "titleLines": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 24
      },
      "minItems": 1,
      "maxItems": 2
    }
  },
  "required": [
    "version",
    "title",
    "authorId",
    "scenes"
  ],
  "additionalProperties": false
}